# =========================================================
# Java / Gradle
# =========================================================
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/
out/
bin/

# Compiled classes and archives
*.class
*.jar
*.war
*.ear
*.nar
# Keep the Gradle wrapper so the project builds without a local Gradle install
!gradle/wrapper/gradle-wrapper.jar

# JVM crash and replay logs
hs_err_pid*
replay_pid*

# =========================================================
# Node / React / Vite
# =========================================================
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo
.eslintcache
.stylelintcache
.npm/
.pnpm-store/

# Yarn (Berry) cache and state, keeping the committed config pieces
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Vite local overrides
*.local

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================================================
# Logs
# =========================================================
logs/
*.log

# =========================================================
# IntelliJ IDEA
# =========================================================
.idea/
*.iml
*.ipr
*.iws

# =========================================================
# Environment files and secrets
# =========================================================
.env
.env.*
!.env.example

# Private keys, certificates, and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore

# Local-only Spring config overrides
application-local.properties
application-local.yml
application-local.yaml

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.fuse_hidden*
.nfs*
.Trash-*